# Local development defaults. For deployment see docs/deployment.md.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/pawbridge.sqlite
# Required when listening on a public/container interface; choose a long random value.
PAWBRIDGE_SETUP_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
